# Backend Service
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
FERNET_SECRET_KEY=base64-fernet-key
OPENAI_API_KEY=sk-your-openai-key
COMPOSIO_API_KEY=cmp-your-composio-key
COMPOSIO_ACCOUNT_ID=your-composio-account-id
AGENT_RUNTIME_BASE_URL=http://localhost:8000

# Gmail OAuth
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3005/oauth/callback
GOOGLE_OAUTH_SCOPE=https://www.googleapis.com/auth/gmail.modify

# Electron App
ELECTRON_API_BASE_URL=http://localhost:8000
ELECTRON_LOG_LEVEL=info

# Optional Integrations
SENTRY_DSN=
POSTHOG_API_KEY=
